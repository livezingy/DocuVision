!test_data/testfiles/**/*.png
!test_data/testfiles/**/*.tiff
!test_data/testfiles/**/*.tif
# GT baselines (generated by test_data/scripts/gt_build_arxiv.py, consumed by gt_diff_report.py)
!test_data/testfiles/**/gt/
!test_data/testfiles/**/gt/*.json

# Staging intermediates stay untracked (`git rm --cached` 2026-09-17). This MUST stay last:
# the `!test_data/testfiles/**` negations above re-include every PDF, so the earlier
# `test_data/testfiles/GeneralFiles_staging/` line alone does not keep them out.
test_data/testfiles/GeneralFiles_staging/
