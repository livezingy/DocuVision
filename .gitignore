# DocuVision Project Specific
# Output files (generated by the application)
outputs/
backend/outputs/
*.docx
*.xlsx
*.json
!package.json
!package-lock.json
!tsconfig.json
!playwright.config.js
!frontend/shared/demo_classification_mappings.json
!test_data/scripts/package.json
# Full OpenAPI snapshot baseline (v1.8.2 SPLIT-U1)
!backend/tests/snapshots/*.json
# Test registration table (P-008 check 4) - the audit reads it, so it must be versioned
!backend/tests/test_registry.json
# E2E runtime-error allowlist (P-008 gap 2, step 2) - the Playwright fixture reads it and it is
# the gate's own tolerance list, so it must be versioned and reviewable as data
!frontend/tests/e2e/expected-errors.json

