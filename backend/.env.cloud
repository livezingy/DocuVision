# Cloud / GPU workspace defaults (safe to commit — no secrets).
# Copy to backend/.env when .env is missing, then adjust paths for your host.

# OCR language for PaddleOCR (ch | en | multi)
OCR_LANG=en

# PaddleX model cache root — official models land in <root>/official_models.
# Bridged into the process env by app/core/config.py BEFORE paddlex import, so setting it
# here (or in backend/.env) is enough; a shell-exported value still wins.
# Empty = PaddleX default (~/.paddlex), which is NOT persistent on Baidu AI Studio:
# only /home/aistudio/work survives a restart, so keep the cache under it, e.g.:
# PADDLE_PDX_CACHE_HOME=/home/aistudio/work/paddlex_cache

# KIE uses Qwen2.5-VL via Hugging Face / transformers (not PaddleNLP UIE). Overrides match app/core/config.py.
# ModelScope cache is under ~/.cache/... for the runtime user (Baidu AI Studio: /home/aistudio/.cache/...).
# Do NOT use /root/.cache/... on AI Studio unless that directory exists and is readable.
# On AI Studio, point at a persistent copy under /home/aistudio/work, e.g.:
# DOCUVISION_KIE_QWEN_MODEL_ID=/home/aistudio/work/kie/Qwen2.5-VL-3B-Instruct
# DOCUVISION_KIE_QWEN_DEVICE_MAP=auto
# DOCUVISION_KIE_QWEN_TORCH_DTYPE=bfloat16

# Disable uvicorn reload on cloud GPU (reload kills PPStructure worker during first model download).
DEBUG=false

# First PPStructure model download on AI Studio can exceed 120s; increase if Layout Engines: [].
APP_LAYOUT_WORKER_INIT_TIMEOUT=300

# Optional: background-load KIE weights after API startup (non-fatal on failure). See docs/architecture/kie.md.
# Cloud GPU profile: enabled by default when copying this file to .env; comment out on memory-tight dev boxes.
DOCUVISION_KIE_WARMUP=1

# Heavy on-GPU KIE pytest: set before running backend/tests/test_kie_acceptance_baseline.py
# DOCUVISION_RUN_KIE_ACCEPTANCE=1

# aistudio-sdk is pinned in requirements.txt; PaddleX snapshot_download is shimmed in app.core.aistudio_compat.
