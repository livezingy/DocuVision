# Cloud / GPU workspace defaults (safe to commit — no secrets).
# Copy to backend/.env when .env is missing, then adjust paths for your host.

# OCR language for PaddleOCR (ch | en | multi)
OCR_LANG=en

# PaddleX model home (optional). On Cloud Studio, mount a persistent volume and set explicitly, e.g.:
# PADDLEX_HOME=/root/data/paddlex

# KIE uses Qwen2.5-VL via Hugging Face / transformers (not PaddleNLP UIE). Overrides match app/core/config.py.
# Default model id targets ModelScope cache under /root; change if your cache layout differs.
# DOCUVISION_KIE_QWEN_MODEL_ID=/root/.cache/modelscope/hub/models/Qwen/Qwen2___5-VL-3B-Instruct
# DOCUVISION_KIE_QWEN_DEVICE_MAP=auto
# DOCUVISION_KIE_QWEN_TORCH_DTYPE=bfloat16

# Optional: background-load KIE weights after API startup (non-fatal on failure). See docs/architecture/kie.md.
# DOCUVISION_KIE_WARMUP=1

# Heavy on-GPU KIE pytest: set before running backend/tests/test_kie_acceptance_baseline.py
# DOCUVISION_RUN_KIE_ACCEPTANCE=1

# aistudio-sdk is pinned in requirements.txt; PaddleX snapshot_download is shimmed in app.core.aistudio_compat.
