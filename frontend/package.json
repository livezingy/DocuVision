{
  "name": "docuvision-frontend",
  "version": "1.1.0",
  "private": true,
  "description": "DocuVision frontend test scaffold",
  "scripts": {
    "test": "npm run test:unit",
    "test:unit": "vitest run",
    "test:unit:watch": "vitest",
    "test:e2e": "playwright test",
    "test:e2e:headed": "playwright test --headed",
    "test:e2e:lite": "playwright test --config playwright.lite.config.js"
  },
  "devDependencies": {
    "@playwright/test": "^1.52.0",
    "jsdom": "^25.0.1",
    "vitest": "^2.1.9"
  }
}
