# Cloud test defaults (checked into git)
# Copy this file to backend/.env before running backend/run.py when .env is missing.
OCR_LANG=en

# KIE: PaddleNLP UIE 模型缓存目录（持久化卷复用，避免每次重启重新下载 ~600MB 权重）
# Cloud Studio 实例需事先 mkdir -p ~/data/.paddlenlp 并保证持久化盘已挂载
PPNLP_HOME=~/data/.paddlenlp

# aistudio-sdk：与 PaddleNLP 对齐须 pin 0.2.6；PaddleX 的 snapshot_download 由 app.core.aistudio_compat 在 import paddlex 前 shim
# pip install aistudio-sdk==0.2.6
